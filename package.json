{
  "name": "retailpulse",
  "private": true,
  "workspaces": [
    "services/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w services/api",
    "dev:web": "npm run dev -w apps/web",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate -w services/api",
    "db:seed": "npm run seed -w services/api --",
    "sim:pos": "node scripts/simulation/pos-sim.mjs",
    "demo": "npm run db:migrate && npm run db:seed && node scripts/simulation/demo.mjs",
    "measure": "node scripts/simulation/measure.mjs",
    "forecast:history": "cd services/forecasting && .venv/bin/python -m app.synthetic",
    "forecast:serve": "cd services/forecasting && .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "forecast:measure": "cd services/forecasting && .venv/bin/python -m app.evaluation.report",
    "forecast:test": "cd services/forecasting && .venv/bin/ruff check . && .venv/bin/pytest -q",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:int": "npm run test:int -w services/api",
    "test:e2e": "npm run build -w services/api && npm run test:e2e -w apps/web",
    "build": "npm run build --workspaces",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
