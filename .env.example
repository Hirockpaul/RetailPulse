# Copy to .env and change values. Never commit .env.
POSTGRES_USER=retailpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=retailpulse
POSTGRES_PORT=5432

DATABASE_URL=postgresql://retailpulse:change-me@localhost:5432/retailpulse

API_PORT=3000
FORECAST_PORT=8000

# Shared password for the fictional demo accounts created by `npm run db:seed`.
# Local demo use only; choose your own (12+ characters).
DEMO_PASSWORD=demo-change-me-123

# Event worker (outbox -> consumers) runs inside the API. Optional.
# EVENT_WORKER_ENABLED=true
# EVENT_POLL_MS=1000

# Background jobs: hourly cleanup of processed outbox events and old idempotency keys (7-day
# retention) and the daily ABC/XYZ classification. Default on, off in tests.
# HOUSEKEEPING_ENABLED=true

# Grafana admin password for the optional observability profile (viewing needs no login).
# GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Password injected into Grafana's restricted PostgreSQL datasource user. Required only for the
# optional observability profile; use a different value from POSTGRES_PASSWORD.
# GRAFANA_DB_PASSWORD=change-me-grafana-db

# Where the API finds the internal forecasting service (default shown).
# FORECAST_URL=http://127.0.0.1:8000

# Forecast artifacts are service-owned files. Default: services/forecasting/.artifacts/models
# MODEL_ARTIFACT_DIR=/absolute/path/to/private/model-artifacts

# Optional MLflow mirror. Leave unset for normal development. With the compose `mlops` profile:
# MLFLOW_TRACKING_URI=http://mlflow:5000

# Optional OTLP/HTTP tracing. Leave unset for normal development. With Compose, enable both the
# `full` and `tracing` profiles and use the private Jaeger endpoint below.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
